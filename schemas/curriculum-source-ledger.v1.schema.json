{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontarioedai.local/schemas/curriculum-source-ledger.v1.schema.json",
  "title": "OntarioEdAI Curriculum Source Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ledger_version", "jurisdiction", "effective_date", "sources", "routing"],
  "properties": {
    "schema": {"const": "ontarioedai-curriculum-source-ledger.v1"},
    "ledger_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "jurisdiction": {"const": "CA-ON"},
    "effective_date": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "namespace",
          "classification",
          "authority",
          "official_recognition",
          "default_url",
          "upstream_document_sha256",
          "upstream_digest_status",
          "review_status",
          "licence"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "namespace": {"type": "string", "minLength": 1, "maxLength": 256},
          "classification": {
            "enum": ["official-derived", "ontarioedai-extension", "third-party-oer"]
          },
          "authority": {"type": "string", "minLength": 1, "maxLength": 500},
          "official_recognition": {"type": "boolean"},
          "default_url": {"type": ["string", "null"], "maxLength": 2048},
          "upstream_document_sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "upstream_digest_status": {"type": "string", "minLength": 1, "maxLength": 128},
          "review_status": {"type": "string", "minLength": 1, "maxLength": 256},
          "licence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rights_holder", "usage_basis", "redistribution_status", "notice"],
            "properties": {
              "rights_holder": {"type": "string", "minLength": 1, "maxLength": 500},
              "usage_basis": {"type": "string", "minLength": 1, "maxLength": 256},
              "redistribution_status": {"type": "string", "minLength": 1, "maxLength": 256},
              "notice": {"type": "string", "minLength": 1, "maxLength": 2000}
            }
          }
        }
      }
    },
    "routing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["course_code_pattern", "source_id"],
        "properties": {
          "course_code_pattern": {"type": "string", "minLength": 1, "maxLength": 256},
          "source_id": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  }
}
