{"$id":"https://axiom.local/schemas/mth1w-promotion-gate-config.v1.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Machine-readable configuration for the MTH1W promotion gate. The gate records promotion decisions and their configs; it does not appoint reviewers and does not confer production, licensing, grade/credit, or Ministry authority.","properties":{"claim_boundaries":{"items":{"maxLength":512,"minLength":1,"type":"string"},"minItems":1,"type":"array","uniqueItems":true},"course":{"additionalProperties":false,"properties":{"assessment_plan_path":{"maxLength":512,"minLength":1,"type":"string"},"course_code":{"const":"MTH1W"},"course_payload_path":{"maxLength":512,"minLength":1,"type":"string"}},"required":["course_code","course_payload_path","assessment_plan_path"],"type":"object"},"gate_id":{"const":"mth1w-promotion-gate"},"gate_version":{"pattern":"^[1-9][0-9]*$","type":"string"},"ledger":{"additionalProperties":false,"properties":{"ledger_path":{"maxLength":512,"minLength":1,"type":"string"},"ledger_schema":{"const":"axiom-education-mth1w-promotion-ledger.v1"}},"required":["ledger_path","ledger_schema"],"type":"object"},"promotion_decisions":{"items":{"enum":["promote","hold","reject"]},"minItems":1,"type":"array","uniqueItems":true},"quorum":{"additionalProperties":false,"properties":{"all_required_review_types_approved":{"const":true},"min_distinct_reviewers":{"minimum":1,"type":"integer"}},"required":["min_distinct_reviewers","all_required_review_types_approved"],"type":"object"},"required_confirmations":{"items":{"maxLength":128,"minLength":1,"type":"string"},"minItems":1,"type":"array","uniqueItems":true},"required_decision":{"const":"approved"},"required_review_types":{"items":{"enum":["educator-instructional","cultural-context","accessibility","assessment-validity","licensing"]},"minItems":1,"type":"array","uniqueItems":true},"reviewer_slots":{"items":{"additionalProperties":false,"prope