{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontarioedai.local/schemas/curriculum-pack.v1.schema.json",
  "title": "OntarioEdAI Curriculum Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pack_id",
    "pack_version",
    "jurisdiction",
    "content_version",
    "effective_date",
    "record_schema",
    "builder",
    "input",
    "source_ledger",
    "records",
    "course_index",
    "classification_counts"
  ],
  "properties": {
    "schema": {"const": "ontarioedai-curriculum-pack.v1"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9.-]{3,128}$"},
    "pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "jurisdiction": {"const": "CA-ON"},
    "content_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "effective_date": {"type": "string", "format": "date"},
    "record_schema": {"const": "ontarioedai-curriculum-record.v1"},
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "canonicalization"],
      "properties": {
        "name": {"const": "tools/curriculum_pack.py"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "canonicalization": {"const": "utf8-nfc-json-sort-keys-compact-newline-v1"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "schema", "ledger_version", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1, "maxLength": 256},
        "schema": {"const": "ontarioedai-curriculum-source-ledger.v1"},
        "ledger_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "count", "course_count"],
      "properties": {
        "file": {"const": "records.jsonl"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "count": {"type": "integer", "minimum": 1},
        "course_count": {"type": "integer", "minimum": 1}
      }
    },
    "course_index": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["course_code", "record_count", "source_id", "official_recognition", "records_sha256"],
        "properties": {
          "course_code": {"type": "string", "pattern": "^[0-9A-Z]{2,16}$"},
          "record_count": {"type": "integer", "minimum": 1},
          "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "official_recognition": {"type": "boolean"},
          "records_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "classification_counts": {
      "type": "object",
      "propertyNames": {"enum": ["official-derived", "ontarioedai-extension", "third-party-oer"]},
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
