{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.local/schemas/accessibility-review-evidence.v1.schema.json",
  "title": "Axiom Education Accessibility Review Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "course_code",
    "review_scope",
    "target",
    "reviewer",
    "reviewed_at",
    "decision",
    "tested_environments",
    "confirmations",
    "findings",
    "scope_limitations",
    "attestation_type"
  ],
  "properties": {
    "schema": {"const": "axiom-education-accessibility-review-evidence.v1"},
    "review_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "course_code": {"const": "MTH1W"},
    "review_scope": {
      "enum": ["lesson-alternative", "learner-application-surface"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "lesson_id", "unit_id", "platform", "target_sha256"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "lesson_id": {"type": ["string", "null"]},
        "unit_id": {"type": ["string", "null"]},
        "platform": {
          "type": ["string", "null"],
          "enum": [null, "android", "windows", "macos", "ios"]
        },
        "target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "qualification"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "qualification": {"type": "string", "minLength": 1},
        "organization": {"type": ["string", "null"]}
      }
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["approved", "changes-required", "rejected"]},
    "tested_environments": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "confirmations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assistive_document_compatibility_reviewed": {"type": "boolean"},
        "printable_offline_usability_reviewed": {"type": "boolean"},
        "nonvisual_equivalence_reviewed": {"type": "boolean"},
        "alternate_response_routes_reviewed": {"type": "boolean"},
        "cognitive_usability_reviewed": {"type": "boolean"},
        "keyboard_navigation_reviewed": {"type": "boolean"},
        "screen_reader_navigation_reviewed": {"type": "boolean"},
        "text_scaling_reflow_reviewed": {"type": "boolean"},
        "contrast_and_noncolor_cues_reviewed": {"type": "boolean"},
        "motion_independence_reviewed": {"type": "boolean"},
        "focus_order_and_labels_reviewed": {"type": "boolean"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "description", "disposition"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["note", "minor", "major", "critical"]},
          "description": {"type": "string", "minLength": 1},
          "disposition": {
            "enum": ["open", "resolved", "accepted-with-rationale", "not-applicable"]
          },
          "resolution_reference": {"type": ["string", "null"]}
        }
      }
    },
    "scope_limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "attestation_type": {"const": "human-accessibility-usability-review"},
    "notes": {"type": "string"}
  }
}
