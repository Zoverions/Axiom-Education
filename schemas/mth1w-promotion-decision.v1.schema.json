{"$id":"https://axiom.local/schemas/mth1w-promotion-decision.v1.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"One promotion decision recorded by the MTH1W promotion gate. A decision binds a promotion outcome to the exact gate config version, the exact content digests, and the exact review evidence digests it considered. Ledger entries form a hash chain via previous_entry_digest; entry_digest covers the whole record.","properties":{"content":{"additionalProperties":false,"properties":{"assessment_plan_digest":{"pattern":"^[0-9a-f]{64}$","type":"string"},"course_payload_digest":{"pattern":"^[0-9a-f]{64}$","type":"string"}},"required":["course_payload_digest","assessment_plan_digest"],"type":"object"},"decided_at":{"format":"date-time","type":"string"},"decided_by":{"maxLength":256,"minLength":1,"type":"string"},"decision":{"enum":["promote","hold","reject"]},"decision_id":{"maxLength":128,"minLength":1,"type":"string"},"entry_digest":{"pattern":"^[0-9a-f]{64}$","type":"string"},"gate_config_digest":{"pattern":"^[0-9a-f]{64}$","type":"string"},"gate_id":{"const":"mth1w-promotion-gate"},"gate_version":{"pattern":"^[1-9][0-9]*$","type":"string"},"previous_entry_digest":{"pattern":"^[0-9a-f]{64}$","type":["string","null"]},"rationale_digest":{"pattern":"^[0-9a-f]{64}$","type":"string"},"review_evidence_digests":{"items":{"pattern":"^[0-9a-f]{64}$","type":"string"},"type":"array","uniqueItems":true},"reviewer_slots":{"items":{"additionalProperties":false,"properties":{"appointment_status":{"enum":["unassigned","assigned"]},"review_type":{"maxLength":128,"minLength":1,"type":"string"},"reviewer_name":{"maxLength":256,"type":["string","null"]},"slot_id":{"maxLength":128,"minLength":1,"type":"string"}},"required":["slot_id","review_type","appointment_status"],"type":"object"},"minItems":1,"type":"array"},"schema":{"const":"axiom-education-mth1w-promotion-decision.v1"}},"required":["schema","decision_id","gate_id","gate_version","gate_config_digest","decision","decided_at","decided_by","content","review_evidence_digests","reviewer_slots","rationale_digest","previous_entry_digest","entry_digest"],"title":"Axiom Education MTH1W Promotion Decision v1","type":"object"}