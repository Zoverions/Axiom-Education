{
  "contract": "axiom-education-personal-insight-vault",
  "version": 1,
  "status": "draft-foundation",
  "purpose": "Store and use consented, evidence-bound learner insight without turning psychological or health context into uncontrolled profiles, diagnosis-by-model, mastery, grades, credentials, public reputation, or commercial targeting.",
  "sensitivity_classes": [
    "ordinary-preference",
    "educational-sensitive",
    "psychological-sensitive",
    "clinical-health-restricted"
  ],
  "source_types": [
    "learner-self-report",
    "guardian-observation",
    "educator-observation",
    "task-evidence",
    "structured-assessment",
    "clinician-provided",
    "model-hypothesis"
  ],
  "purposes": [
    "presentation-adaptation",
    "instructional-strategy",
    "metacognitive-feedback",
    "learner-self-reflection",
    "accessibility-support",
    "wellbeing-support",
    "educator-support",
    "guardian-support",
    "clinical-accommodation"
  ],
  "permissions": [
    "read",
    "use",
    "propose-revision",
    "confirm",
    "dispute",
    "correct",
    "revoke"
  ],
  "revision_types": [
    "confirm",
    "dispute",
    "correct",
    "revoke"
  ],
  "record_requirements": {
    "exact_learner_subject": true,
    "explicit_claim_type": true,
    "explicit_source_type": true,
    "provenance_evidence_required": true,
    "domain_scope_required": true,
    "limitations_required": true,
    "review_time_required": true,
    "expiry_time_required": true,
    "model_hypothesis_requires_confidence": true,
    "model_hypothesis_may_create_clinical_diagnosis": false,
    "clinical_diagnosis_claim_requires_clinician_provided_source": true
  },
  "access_requirements": {
    "exact_actor": true,
    "exact_learner_subject": true,
    "purpose_bound": true,
    "permission_bound": true,
    "sensitivity_bound": true,
    "domain_bound": true,
    "evidence_backed_grant": true,
    "grant_expiry_required": true,
    "grant_revocable": true,
    "sensitive_read_or_use_requires_access_receipt_reservation": true,
    "descriptive_role_alone_creates_access": false
  },
  "revision_invariants": {
    "corrections_are_append_only": true,
    "correction_rewrites_original_provenance": false,
    "learner_confirmation_turns_model_hypothesis_into_clinician_fact": false,
    "dispute_is_preserved_in_history": true,
    "revocation_blocks_future_use_without_silently_rewriting_history": true
  },
  "model_materialization_boundary": {
    "vault_grant_alone_authorizes_model_materialization": false,
    "separate_education_model_context_grant_required": true,
    "remote_egress_requires_separate_model_context_authority": true,
    "retention_requires_separate_model_context_authority": true
  },
  "non_authority_invariants": {
    "insight_establishes_mastery": false,
    "insight_creates_grade_or_credit": false,
    "insight_mints_credential": false,
    "insight_creates_public_profile_by_default": false,
    "insight_federates_across_services_by_default": false,
    "sensitive_insight_may_be_used_for_commercial_targeting": false,
    "generic_psychological_score_is_learning_truth": false,
    "permanent_learning_style_label_is_allowed": false
  },
  "learner_agency": {
    "inspect_source_and_provenance": true,
    "inspect_confidence_and_limitations_where_applicable": true,
    "confirm": true,
    "dispute": true,
    "correct": true,
    "revoke_future_use": true,
    "inspect_sensitive_access_receipts": true
  }
}
