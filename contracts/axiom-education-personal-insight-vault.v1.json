    "confirm",
    "dispute",
    "correct",
    "revoke"
  ],
  "record_requirements": {
    "exact_learner_subject": true,
    "explicit_claim_type": true,
    "explicit_source_type": true,
    "provenance_evidence_required": true,
    "domain_scope_required": true,
    "limitations_required": true,
    "review_time_required": true,
    "expiry_time_required": true,
    "model_hypothesis_requires_confidence": true,
    "model_hypothesis_may_create_clinical_diagnosis": false,
    "clinical_diagnosis_claim_requires_clinician_provided_source": true
  },
  "access_requirements": {
    "exact_actor": true,
    "exact_learner_subject": true,
    "purpose_bound": true,
    "permission_bound": true,
    "sensitivity_bound": true,
    "domain_bound": true,
    "evidence_backed_grant": true,
    "grant_expiry_required": true,
    "grant_revocable": true,
    "sensitive_read_or_use_requires_access_receipt_reservation": true,
    "descriptive_role_alone_creates_access": false
  },
  "revision_invariants": {
    "corrections_are_append_only": true,
