  "non_authority_invariants": {
    "insight_establishes_mastery": false,
    "insight_creates_grade_or_credit": false,
    "insight_mints_credential": false,
    "insight_creates_public_profile_by_default": false,
    "insight_federates_across_services_by_default": false,
    "sensitive_insight_may_be_used_for_commercial_targeting": false,
