{
  "schema": "axiom-education-instructional-effectiveness.v1",
  "contract_id": "axiom.education.instructional-effectiveness",
  "contract_version": "1.0.0",
  "domain": "education",
  "status": "draft-foundation-not-promoted-capability",
  "purpose": "Select and evaluate instructional strategies, resources, tools, human support, and model-assisted experiences using durable learning outcomes and governed evidence rather than generic engagement optimization.",
  "evidence_levels": [
    "official-or-standards-framework",
    "systematic-review-or-meta-analysis",
    "randomized-controlled-trial",
    "strong-quasi-experimental-or-replicated-field-evidence",
    "observational-or-implementation-evidence",
    "local-governed-evaluation",
    "pilot-or-exploratory-evidence",
    "hypothesis-or-unverified-design"
  ],
  "evidence_record_fields": [
    "source-id",
    "publication-id",
    "publication-date",
    "review-date",
    "evidence-level",
    "learner-stage",
    "domain",
    "setting",
    "population-notes",
    "country-or-context",
    "language",
    "measured-outcomes",
    "effect-estimate",
    "uncertainty-and-limitations",
    "independence-or-conflict-notes",
    "applicability-notes"
  ],
  "strategy_classes": [
    "explicit-explanation",
    "direct-instruction",
    "worked-example",
    "guided-practice",
    "independent-practice",
    "retrieval-with-feedback",
    "spaced-review",
    "interleaving",
    "multiple-representations",
    "socratic-questioning",
    "self-explanation",
    "metacognition-and-self-regulation",
    "mastery-oriented-pacing",
    "peer-explanation",
    "peer-tutoring",
    "small-group-tutoring",
    "one-to-one-tutoring",
    "project-based-learning",
    "problem-based-learning",
    "phenomenon-based-learning",
    "simulation",
    "story-or-comic",
    "game-based-challenge",
    "creative-construction",
    "authentic-real-world-task",
    "human-educator-escalation",
    "ai-tutoring",
    "human-ai-copilot"
  ],
  "primary_learning_metrics": [
    "learning-gain",
    "delayed-retention",
    "transfer-or-generalization",
    "misconception-recovery",
    "time-to-demonstrated-criterion",
    "robustness-across-representations"
  ],
  "learner_regulation_metrics": [
    "calibration",
    "help-seeking-effectiveness",
    "strategy-flexibility",
    "learner-agency"
  ],
  "access_safety_equity_metrics": [
    "accessibility-success",
    "barrier-rate",
    "differential-outcome-audit",
    "wellbeing-or-safety-burden"
  ],
  "system_efficiency_metrics": [
    "human-escalation-success",
    "educator-workload",
    "cost-and-compute-efficiency",
    "reliability-and-recoverability"
  ],
  "forbidden_optimization_targets": [
    "watch-time",
    "total-time-in-app",
    "click-through-rate",
    "advertising-yield",
    "streak-length",
    "notification-opens",
    "social-virality",
    "message-volume",
    "raw-screen-time",
    "raw-question-count",
    "generic-engagement-score",
    "facial-expression-inference",
    "gaze-inference",
    "stylus-hesitation-as-cognitive-state"
  ],
  "selection_invariants": {
    "privacy_policy_filters_before_ranking": true,
    "safety_and_readiness_filters_before_ranking": true,
    "accessibility_filters_before_ranking": true,
    "curriculum_or_competency_target_is_preserved": true,
    "evidence_context_must_be_considered": true,
    "single_global_best_strategy_is_assumed": false,
    "single_scalar_learner_score_is_required": false,
    "permanent_learning_style_labels_are_allowed": false,
    "commercial_provider_claim_is_independent_evidence": false,
    "faster_completion_is_success_when_retention_degrades": false,
    "learner_feedback_may_change_curriculum_truth": false
  },
  "measurement_invariants": {
    "immediate_success_alone_establishes_durable_mastery": false,
    "delayed_evidence_supported": true,
    "transfer_evidence_supported": true,
    "device_or_access_failure_counts_as_learner_failure": false,
    "non-response_automatically_counts_as_inability": false,
    "confidence_alone_establishes_mastery": false,
    "one_liked_format_establishes_learning_style": false,
    "raw_time_on_task_is_learning_gain": false
  },
  "tool_admission": {
    "brand_prestige_grants_admission": false,
    "provider_self_report_grants_effectiveness_status": false,
    "capability_profile_required": true,
    "privacy_and_egress_profile_required": true,
    "accessibility_profile_supported": true,
    "cost_and_licensing_profile_supported": true,
    "interoperability_profile_supported": true,
    "evidence_references_supported": true,
    "health_and_reliability_evidence_supported": true
  },
  "research_boundary": {
    "normal_adaptation_is_automatically_human_subject_research": false,
    "cross_learner_randomized_experiment_is_ordinary_product_routing": false,
    "population_experiment_requires_separate_governance": true,
    "minor_research_requires_applicable_consent_assent_and_ethics_controls": true,
    "publishable_efficacy_claim_requires_declared_method_and_outcomes": true,
    "silent_experiment_pooling_is_allowed": false
  },
  "non_claims": [
    "No instructional strategy, country, provider, model, or tool is declared universally best by this contract.",
    "Evidence strength does not override privacy, learner rights, safety, jurisdiction policy, accessibility, or educational authority boundaries.",
    "A locally adaptive choice does not establish population-level efficacy.",
    "An entertaining experience is not educationally effective unless valid learner evidence supports the intended outcome."
  ]
}
